# <<.DisplayName>>
#
# An Agent CR is pure subagent config: it spawns nothing. The entry point is the
# platform's per-namespace preset-agent-hub, and the caller selects agents per
# turn with payload.agent_hub.agent_names[].
#
# TODO before this is usable:
#   1. description - this is ROUTING TEXT for the orchestrator, not a
#      self-introduction. It is the only thing seen when deciding whether to
#      delegate, so put the business nouns in it. Where another agent looks
#      similar, say which side of the line each is on.
#   2. prompt.task and prompt.format are the shared block - copy them from a
#      sibling Agent, and change every copy in one edit. NOTHING CHECKS THIS.
#   3. At least two sampleQuestions while published.
apiVersion: asgard-ai.com/v1alpha1
kind: Agent
metadata:
  name: <<.CRName>>
  annotations:
    asgard-ai.com/agent-name: "<<.DisplayName>>"
  labels:
    # The on/off switch: callers build agent_names[] from the published agents.
    asgard-ai.com/agent-published: "true"
    {{- include "<<.Chart>>.labels" . | nindent 4 }}
spec:
  agentClass: managed
  managed:
    # The delegation name. Convention: the CR name without its ag- prefix.
    aliasName: <<.Name>>
    description: |-
      TODO: when to delegate here.
    # Every field below is 繁體中文 the end user feels, because the agent answers
    # in the register its prompt is written in. Write them to
    # .agents/skills/plain-chinese/ - an agent whose prompt says 賦能 and
    # 至關重要 produces answers that say them too, all day, to customers.
    prompt:
      persona: |-
        TODO: who this agent is. Per agent.
      task: |-
        TODO: the operating rules. The shared block - copy it from a sibling.
      context: |-
        TODO: what it can reach. Per agent.
      format: |-
        TODO: how to answer. The shared block - copy it from a sibling.
    # Shown to the end user in Sindri, so they are 繁體中文 and the customer
    # reads them before anything else this agent says. Write real questions
    # somebody would actually type, to .agents/skills/plain-chinese/ - not
    # 「如何提升營運效率?」, which nobody asks and which the agent cannot answer.
    sampleQuestions:
      - TODO
      - TODO
<<if .SkillSets>>    skillSetNames:
<<range .SkillSets>>      - <<.>>
<<end>><<else>>    # No SkillSet in this chart yet, so none is referenced: a name that does not
    # exist is a dangling reference the gate rejects.
    #
    # An Agent is allowed to have none. But a release with no Syncer has
    # **nothing running after the platform's dry run** - apply fires the Syncers
    # this release deploys that carry auto-fire-on-rollout and waits for them,
    # so with none a succeeded run means helm returned. A SkillSet brings one,
    # so a project heading for a deploy wants one:
    #
    #     asgard-cli add skillset base --repo <git url>
    #
    # Then add it here.
    # skillSetNames:
    #   - sk-base
<<end>><<if .Layer>>    # At most one layer per agent: that is what keeps the search space small.
    # No allowedCubes - any table in this layer is queryable.
    semanticLayers:
      - name: <<.Layer>>
        allowQuery: true
        allowWrite: false
<<else>>    # No semantic layer. An agent needs at least one capability source, so give
    # it toolsetNames instead, or the gate rejects it.
    # toolsetNames:
    #   - ts-<name>
<<end>>
    # The Neko browser sidecar, for a system that has no database to read and
    # no API - only a web console. The flag is the cheap half; the reference
    # documents the agent needs to drive that UI are the work, so none is
    # written here. A plain boolean on an Agent and a `value:` string on a
    # SandboxBlueprint -
    # `.agents/skills/asgard-platform/usecase/browser-operation.md` has both
    # spellings, which of the two settings wins, and when a web UI is the right
    # route at all.
    # browser:
    #   enabled: true

    # Files from a SourceSet, mounted into the shared sandbox pod - and
    # aggregated onto the orchestrator's, not only this subagent's. The mount
    # is a choice about what this agent works on, so none is written.
    #
    # A REAL YAML LIST here. The same field on a SandboxBlueprint is a
    # stringified JSON array, and that pair is the one people copy between
    # wrong - both shapes are side by side in
    # `.agents/skills/asgard-platform/usecase/conventions.md`, which also has
    # where a mount may go and the one parent directory that kills the driver.
    #
    # sourceSetName, mountPath and readOnly are required on every entry, and
    # mountPath must match `^/.+`. Two entries resolving to one mountPath are
    # deduped FIRST-WINS in silence, so the symptom of a collision is a mount
    # that is simply not there. subPath mounts a slice of the store rather than
    # all of it - the only mechanism that does - and a rejected one takes the
    # whole Sandbox not-ready rather than skipping the entry; the same page has
    # what it rejects.
    # sourceSetMounts:
    #   - sourceSetName: ss-<name>
    #     mountPath: /knowledge
    #     readOnly: true
    #     subPath: <dir>/
