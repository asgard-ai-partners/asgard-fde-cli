# <<.DisplayName>>
#
# A SkillSet takes three CRs: the SkillSet, its own SourceSet, and the git
# Syncer that fills it, bound 1:1:1 and kept in this one file.
#
# Do not point several SkillSets at one SourceSet. The Platform UI reads the
# 1:1:1 structure, and sharing leaves it unable to find a skill set's git
# config - it renders as a skill set with no source. Runtime is unaffected, so
# this goes unnoticed.
apiVersion: asgard-ai.com/v1alpha1
kind: SourceSet
metadata:
  name: ss-<<.Name>>
  annotations:
    asgard-ai.com/source-set-name: "<<.DisplayName>> 來源"
  labels:
    # Needed on this CR and on the Syncer, and it does a different thing on
    # each. Here the front end reads it to recognise that this store belongs
    # to one skill set; on the Syncer it keeps the Syncer out of the generic
    # Syncer list. The platform also cascades on it when the SkillSet is
    # deleted.
    asgard-ai.com/managed-by: skill-set
    {{- include "<<.Chart>>.labels" . | nindent 4 }}
spec:
  # The platform mints this and guarantees the Secret in every namespace, so
  # there is nothing to obtain and nothing to declare: `preset-agent-hub` /
  # `api_key` is created by the namespace reconciler, once, and never rotated.
  # The platform's own preset Toolset, SourceSet and BotProvider read it the
  # same way.
  #
  # It is not the X-API-KEY a caller sends when calling
  # the API from outside - see
  # `.agents/skills/asgard-platform/usecase/conventions.md`.
  apiKey:
    valueFrom:
      secretKeyRef:
        name: preset-agent-hub
        key: api_key
---
apiVersion: asgard-ai.com/v1alpha1
kind: Syncer
metadata:
  name: syn-<<.Name>>
  annotations:
    asgard-ai.com/syncer-name: "<<.DisplayName>> 同步"
  labels:
    asgard-ai.com/managed-by: skill-set
    # Scheduler off, and the deploy fires it instead: the platform's apply step
    # fires the Syncers of this release that carry auto-fire-on-rollout and
    # waits for them, so sync timing is tied to deploys on purpose.
    #
    # Both labels are required, and neither reads the other.
    # auto-fire-on-rollout is opt-in and only the platform's runner reads it;
    # the Syncer module ignores it and never looks at suspend. So a suspended
    # Syncer without auto-fire never runs - the skills resolve to zero, the
    # chart renders, the gate passes and nothing reports it.
    asgard-ai.com/syncer-suspend: "true"
    asgard-ai.com/auto-fire-on-rollout: "true"
    {{- include "<<.Chart>>.labels" . | nindent 4 }}
spec:
  sourceSetName: ss-<<.Name>>
  # A relative path inside the volume. The trailing slash is required:
  # without it the CRD rejects the resource.
  destinationPath: "git/"
  # No statePath on a git syncer - it clones the whole tree every run. The
  # incremental cursor belongs to a database syncer.
  syncerClass: git
  schedule: "0 */6 * * *"
  timeZone: Asia/Taipei
  git:
    repoUrl: "<<.Repo>>"
<<if .Private>>    # Pinning the release tag means the tag must be pushed before the Syncer can
    # find its commit, and a local helm upgrade breaks it.
    revision: {{ .Chart.AppVersion | quote }}
    auth:
      type: http
      # The username is a constant, not a secret, so it is written literally
      # and a private repo needs one declared key. The PAT in `password` below
      # is what authenticates. One reference deployment reads
      # the username out of the release Secret as well -
      #
      #   valueFrom:
      #     secretKeyRef:
      #       name: <the release Secret>
      #       key: asgard-github-pat-username
      #
      # - which works, but it is a second key to declare, set and rotate for a
      # value that never varies. Do not copy it
      # into a new chart.
      username:
        value: "git"
      password:
        valueFrom:
          secretKeyRef:
            name: {{ include "<<.Chart>>.appSecretName" . }}
            key: asgard-github-pat-password
<<else>>    revision: "main"
    # A public repo needs no auth block, and no PAT key to declare.
<<end>>---
apiVersion: asgard-ai.com/v1alpha1
kind: SkillSet
metadata:
  name: <<.CRName>>
  annotations:
    asgard-ai.com/skill-set-name: "<<.DisplayName>>"
    # 繁體中文, read in the customer's own console. Vocabulary rules in
    # .agents/skills/plain-chinese/ apply; the sentence-shape ones do not,
    # because this is a phrase rather than a sentence.
    asgard-ai.com/skill-set-description: "TODO"
  labels:
    {{- include "<<.Chart>>.labels" . | nindent 4 }}
spec:
  sourceSetName: ss-<<.Name>>
  searchPaths:
    # One path per skill directory. A parent directory resolves to nothing,
    # and no check catches it - the symptom is an agent with fewer skills than
    # expected.
    - git/TODO/
