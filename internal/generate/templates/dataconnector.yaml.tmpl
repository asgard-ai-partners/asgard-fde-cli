# <<.DisplayName>>
#
# Connection coordinates live in the platform's variables, declared as chartValues, one group per
# connector. The password is only ever a secretKeyRef into the release's own Secret - the Platform
# creates and maintains that Secret, and injects its name; never a value, never in git.
#
# The password key has to be declared under `appSecret:` in .asgard-pipeline.yaml as well as set on
# the platform. Set without declared is stored and never injected, and the CR then resolves to
# nothing at runtime while lint, render and the dry run all stay green.
apiVersion: asgard-ai.com/v1alpha1
kind: DataConnector
metadata:
  name: <<.CRName>>
  annotations:
    # Required. Without it this applies cleanly and shows up nameless in the UI.
    asgard-ai.com/data-connector-name: "<<.DisplayName>>"
  labels:
    {{- include "<<.Chart>>.labels" . | nindent 4 }}
spec:
  dataConnectorClass: <<.DBClass>>
<<.DBSpec>><<if .DBNote>>
# <<.DBNote>>
<<end>>