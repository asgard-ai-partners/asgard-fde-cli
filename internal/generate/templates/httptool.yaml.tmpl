# <<.DisplayName>>
#
<<if .Write>># A WRITE path. The gate is requestConsent: true on the Toolset entry below -
# the harness intercepts the call and waits for a person.
#
# Do not describe an approval flow in any prompt: the gate is the harness's, and
# prompting around it only adds a fake one the model can talk itself past.
#
# This Toolset must NOT be reachable from a Trigger. A scheduled run has nobody
# to approve, so requestConsent: true parks it until it times out.
<<else>># A read tool. requestConsent: false because it changes nothing.
<<end>>#
# TODO before this is usable:
#   1. The endpoint, declared as a chartValue and set on the platform.
#   2. The request body - measure it against the real API, do not infer it from
#      the field names on our side.
#   3. Auth: a config has no valueFrom, so a credential is a variable read back
#      as vars.<name> - the skeleton is beside `variables` below. Do NOT declare
#      a secretKeyRef for a key infra has not created yet - config evaluation
#      fails at call time, so it deploys and then breaks on first use.
apiVersion: asgard-ai.com/v1alpha1
kind: Workflow
metadata:
  name: <<.CRName>>
  annotations:
    asgard-ai.com/workflow-name: "<<.DisplayName>>"
    {{- include "<<.Chart>>.workflowSetAnnotations" (dict "name" "<<.CRName>>" "displayName" "<<.DisplayName>>") | nindent 4 }}
  labels:
    {{- include "<<.Chart>>.workflowSetLabels" (dict "name" "<<.CRName>>" "type" "automation_tool") | nindent 4 }}
    {{- with .Values.asgard.projectEnvironmentId }}
    asgard-ai.com/project-environment-id: {{ . | quote }}
    {{- end }}
    {{- include "<<.Chart>>.labels" . | nindent 4 }}
spec:
  # **A credential goes here and nowhere else**: a config has no valueFrom, so a
  # token is a variable, read back as vars.<name>.
  # `.agents/skills/asgard-platform/usecase/external-api.md` has why the
  # alternatives are not it.
  # - name: apiToken
  #   valueFrom:
  #     secretKeyRef:
  #       name: {{ include "<<.Chart>>.appSecretName" . }}
  #       key: TODO_the_key_infra_created
  # and then, on proc-call below:
  # - name: Authorization
  #   expression: '"Bearer " + vars.apiToken'
  variables: []
  entries:
    - name: entry-main
      handlingProcessor: proc-input
      labels:
        display_name: Entry
      inputSchema: |-
        {
          "type": "object",
          "properties": {
            "TODO": {
              "type": "string",
              "description": "TODO: what to pass, and what NOT to pass."
            }
          },
          "required": ["TODO"]
        }
      tooling:
        # snake_case: this is the name the model sees, not the CR name.
        name: <<.Name>>
        description: |-
          TODO: 繁體中文, to .agents/skills/plain-chinese/ - the model reads
          this to decide whether to call the tool. Say what it does and what it
          returns.
          Say explicitly that the agent must call this rather than answer from
          memory, and say what an empty result means - otherwise it will treat
          "nothing found" as a failed lookup and try another way.
          Then name the tool this could be confused with, and say which to
          prefer: "for X use this, for Y use <other>". Two descriptions can
          each be accurate and still not say which answers the question, and
          that is the failure nothing can check for you.
          Read them together afterwards: asgard-cli verify --tools
        allowUploadFile: false
  # No exit: the run ends when its last processor finishes. Declare one where a
  # named end is worth seeing on the canvas, and route the last relationship at
  # it - `to` takes exactly one of processor and exit.
  # - name: finish
  #   labels:
  #     display_name: Exit
  # - from: {processor: proc-response, relationName: success}
  #   to:
  #     exit: finish
  exits: []
  processors:
    # MUST come first. After http-request, prevPayload is the HTTP response,
    # not the tool arguments - anything not pulled into context here is gone.
    - name: proc-input
      type: update-context
      labels:
        display_name: read parameters
      configs:
        - name: inputValue
          expression: |-
            (() => {
              return String(prevPayload.TODO || "").trim();
            })()

    - name: proc-call
      type: http-request
      labels:
        display_name: HTTP Request
      configs:
        - name: url
          value: {{ .Values.<<.ValuesKey>>.endpoint | quote }}
        - name: method
          value: <<if .Write>>POST<<else>>GET<<end>>
        # A string, like every config value.
        - name: parseJson
          value: "true"
        - name: body
          expression: |-
            (() => {
              return JSON.stringify({ TODO: inputValue });
            })()
        # Headers are configs, named after the header.
        - name: Content-Type
          value: application/json

    - name: proc-response
      type: push-message
      labels:
        display_name: Response
      configs:
        - name: payload
          expression: |-
            (() => {
              // Guard the whole path: a failed call leaves httpResponse absent,
              // and an expression that throws takes the tool with it.
              const body = (httpResponse && httpResponse.json) || null;
              return { raw: body };
            })()

    # **A failed call has to say so.** Without this branch the run ends at
    # proc-call and the tool returns nothing, which the model reads as "no
    # result" rather than "the call failed" - and then answers from memory.
    - name: proc-error
      type: push-message
      labels:
        display_name: Error
      configs:
        - name: payload
          expression: |-
            (() => {
              return { error: (prevError && String(prevError)) || "the request failed" };
            })()

  # **`relationships` is what runs the chain.** Without it the run starts at the
  # entry's handlingProcessor and stops there: the arguments are read into
  # context and the HTTP call is never made. The CR is legal either way, so
  # helm lint, CRD validation, the server-side dry run and `asgard-cli verify`
  # are all green while the tool does one third of what this file looks like it
  # does - and an agent handed silence answers from memory.
  relationships:
    - from: {processor: proc-input, relationName: success}
      to: {processor: proc-call}
    - from: {processor: proc-call, relationName: success}
      to: {processor: proc-response}
    - from: {processor: proc-call, relationName: failure}
      to: {processor: proc-error}
---
apiVersion: asgard-ai.com/v1alpha1
kind: Toolset
metadata:
  name: <<.Toolset>>
  annotations:
    asgard-ai.com/toolset-name: "<<.DisplayName>>"
    # 繁體中文, read in the customer's own console. Vocabulary rules in
    # .agents/skills/plain-chinese/ apply; the sentence-shape ones do not,
    # because this is a phrase rather than a sentence.
    asgard-ai.com/toolset-description: "TODO"
  labels:
    {{- include "<<.Chart>>.labels" . | nindent 4 }}
spec:
  toolsetClass: workflow-tooling
  # **The platform mints this and guarantees the Secret in every namespace**, so
  # there is nothing to obtain and nothing to declare: `preset-agent-hub` /
  # `api_key` is created by the namespace reconciler, once, and never rotated.
  # The platform's own preset Toolset, SourceSet and BotProvider read it the
  # same way. **Proved end to end for a SourceSet** - applied, Ready, its
  # Syncers ran - and to the server-side dry run for a Toolset, 2026-09-14. A
  # BotProvider's adminApiKey is the same field resolved by the same code and
  # has not been exercised.
  #
  # It is NOT the X-API-KEY the documentation tells you to create for calling
  # the API from outside - see
  # `.agents/skills/asgard-platform/usecase/conventions.md`.
  apiKey:
    valueFrom:
      secretKeyRef:
        name: preset-agent-hub
        key: api_key
  tools:
    - entrypoint:
        entry: entry-main
        workflow: <<.CRName>>
      requestConsent: <<if .Write>>true<<else>>false<<end>>
