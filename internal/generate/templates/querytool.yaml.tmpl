# <<.DisplayName>>
#
# A zero-parameter query. No user input reaches SQL, so the injection surface is
# zero - that property is the reason this shape exists for a public audience.
# Do not add parameters: interpolating a keyword re-opens exactly the hole it
# closes. A query that wants a filter gets rewritten to aggregate instead.
#
# Do not ship a second tool on the same FROM/JOIN differing only in projection:
# each description then has to name the other as the alternative, which is where
# a model picks wrong. Make the difference a column value.
apiVersion: asgard-ai.com/v1alpha1
kind: Workflow
metadata:
  name: <<.CRName>>
  annotations:
    asgard-ai.com/workflow-name: "<<.DisplayName>>"
    {{- include "<<.Chart>>.workflowSetAnnotations" (dict "name" "<<.CRName>>" "displayName" "<<.DisplayName>>") | nindent 4 }}
  labels:
    {{- include "<<.Chart>>.workflowSetLabels" (dict "name" "<<.CRName>>" "type" "automation_tool") | nindent 4 }}
    {{- with .Values.asgard.projectEnvironmentId }}
    asgard-ai.com/project-environment-id: {{ . | quote }}
    {{- end }}
    {{- include "<<.Chart>>.labels" . | nindent 4 }}
spec:
  variables: []
  entries:
    - name: entry-main
      handlingProcessor: proc-query
      labels:
        display_name: Entry
      inputSchema: |-
        {
          "type": "object",
          "properties": {}
        }
      tooling:
        name: <<.Name>>
        description: |-
          TODO: 繁體中文, to .agents/skills/plain-chinese/ - the model reads
          this to decide whether to call the tool, so an adjective here costs a
          wrong tool choice. Say what it returns, how many rows, and when to
          reach for it.
          Record the row count you measured, and when you measured it.
          Then name the tool this could be confused with, and say which to
          prefer: "for X use this, for Y use <other>". That last sentence is
          the whole difference between a set of tools a model can choose from
          and a set it guesses between - each description can be accurate on
          its own and still not say which one answers the question.
          Read them together afterwards: asgard-cli verify --tools
        allowUploadFile: false
  exits: []
  processors:
    - name: proc-query
      type: query-database
      labels:
        display_name: SQL
      configs:
        - name: dataConnector
          value: <<.Connector>>
        # **Not optional, and not what the name suggests.** query-database
        # resolves a MISSING allowWrite to TRUE - the definitions give it a
        # default of true and describe it as permitting INSERT, UPDATE, DELETE
        # and DDL. So a processor configured by adding only what you want is a
        # write path, and the rendered chart does not show that it happened.
        # This shape serves anonymous callers; leave it false.
        - name: allowWrite
          value: "false"
        - name: resultField
          value: rows
        - name: sql
          value: |-
            -- TODO. Run it against the live database before committing.
            -- Put the reasoning in this comment: soft deletes, why a COUNT is
            -- DISTINCT, how a path is built. There is nowhere else for it.
            select 1

    # **The query needs somewhere to come out.** `resultField` names the
    # variable the rows land in; this is what returns them to the caller. A
    # query with no response processor runs, succeeds, and answers nothing -
    # and every deployed fixed query tool has this pair.
    - name: proc-response
      type: push-message
      labels:
        display_name: Response
      configs:
        - name: payload
          expression: |-
            (() => {
              return rows;
            })()

  # **`relationships` is what runs the chain.** Without it the run starts at
  # the entry's handlingProcessor and stops there. The CR is legal either way,
  # so helm lint, CRD validation, the server-side dry run and `asgard-cli
  # verify` are all green while the tool returns nothing - and an agent handed
  # silence answers from memory.
  relationships:
    - from: {processor: proc-query, relationName: success}
      to: {processor: proc-response}
<<if .ToolsetExists>># The Toolset <<.Toolset>> already exists in this chart, so it is not written
# again here: two CRs with one name means whichever applies last replaces the
# other, and the tools in the discarded copy are silently gone.
#
# Add this tool to the existing set instead - one entry under its `tools`:
#
#     - entrypoint:
#         entry: entry-main
#         workflow: <<.CRName>>
#       requestConsent: false
#
# Those two fields are the whole entry. A Toolset tool carries NO name and NO
# description - writing them here is an unknown field the apiserver drops in
# silence, and the tool reaches the model unnamed.
#
# Both live on the Workflow entry's `tooling` block above, which is where the
# text the model reads to choose between tools already is. Say there which
# other tool this one could be confused with.
<<else>>---
apiVersion: asgard-ai.com/v1alpha1
kind: Toolset
metadata:
  name: <<.Toolset>>
  annotations:
    asgard-ai.com/toolset-name: "<<.DisplayName>>"
    # 繁體中文, read in the customer's own console. Vocabulary rules in
    # .agents/skills/plain-chinese/ apply; the sentence-shape ones do not,
    # because this is a phrase rather than a sentence.
    asgard-ai.com/toolset-description: "TODO"
  labels:
    {{- include "<<.Chart>>.labels" . | nindent 4 }}
spec:
  toolsetClass: workflow-tooling
  # **The platform mints this and guarantees the Secret in every namespace**, so
  # there is nothing to obtain and nothing to declare: `preset-agent-hub` /
  # `api_key` is created by the namespace reconciler, once, and never rotated.
  # The platform's own preset Toolset, SourceSet and BotProvider read it the
  # same way. **Proved end to end for a SourceSet** - applied, Ready, its
  # Syncers ran - and to the server-side dry run for a Toolset, 2026-09-14. A
  # BotProvider's adminApiKey is the same field resolved by the same code and
  # has not been exercised.
  #
  # It is NOT the X-API-KEY the documentation tells you to create for calling
  # the API from outside - see
  # `.agents/skills/asgard-platform/usecase/conventions.md`.
  apiKey:
    valueFrom:
      secretKeyRef:
        name: preset-agent-hub
        key: api_key
  tools:
    - entrypoint:
        entry: entry-main
        workflow: <<.CRName>>
      requestConsent: false
<<end>>